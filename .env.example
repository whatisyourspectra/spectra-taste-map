# Spotify OAuth app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# OAuth redirect. Must be registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/auth/callback

# Optional: separate redirect used when the app is reached over the LAN
# (e.g. scanning a QR from a phone). Register this one too if you use it.
# SPOTIFY_MOBILE_REDIRECT_URI=http://<your-lan-ip>:3001/auth/callback

# Origin of the Vite dev client (used for CORS + OAuth return).
CLIENT_APP_ORIGIN=http://127.0.0.1:5173

# Express session secret (set a strong random value in production).
# SESSION_SECRET=change-me

# Set to 'production' to enable secure/sameSite=none cookies.
# NODE_ENV=development
