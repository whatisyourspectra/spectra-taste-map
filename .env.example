# SPECTRA account login — Supabase public browser settings.
# Create a Supabase project and enable its Google provider. See docs/AUTH_SETUP.md.
# Only a public/anon key belongs here; Google Client Secret goes in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, standard Supabase anon keys can be provided as VITE_SUPABASE_ANON_KEY:
# VITE_SUPABASE_ANON_KEY=
# Enable mock auth for local development without Supabase:
# VITE_AUTH_MOCK=1

# Spotify application credentials — used only by the server through the
# Client Credentials flow. Visitors do not sign in with Spotify.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Catalog market used for track matching.
SPOTIFY_MARKET=KR

# Last.fm supplies genre/mood tags for the original Taste Field coordinates.
# Create a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# YouTube Data API v3 key — server-side only. Used to resolve Metro route
# tracks to videos for the visible YouTube mini player.
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_REGION=KR

# Set to 'production' to enable secure cookies / caching in prod.
# NODE_ENV=development

# Optional tuning (defaults shown):
# ENRICH_MAX_TRACKS=1500        # cap tracks processed per import
# SPOTIFY_CACHE_TTL_MS=86400000 # catalog cache lifetime (24h)
# SPOTIFY_CACHE_MAX=5000        # maximum cached catalog entries
# SPOTIFY_REQUEST_CONCURRENCY=3 # simultaneous Spotify catalog requests
# SPOTIFY_REQUEST_TIMEOUT_MS=8000
# SPOTIFY_REQUEST_MIN_INTERVAL_MS=220 # pace request starts to reduce 429 bursts
# SPOTIFY_RATE_LIMIT_MAX_WAIT_MS=120000 # maximum shared Retry-After cooldown
# SPOTIFY_CIRCUIT_FAILURE_THRESHOLD=3 # pause after repeated transient errors
# SPOTIFY_CIRCUIT_COOLDOWN_MS=20000    # retry Spotify after 20 seconds
# LASTFM_CACHE_TTL_MS=86400000  # Last.fm tag cache lifetime (24h)
# YOUTUBE_CACHE_TTL_MS=2592000000 # video match cache lifetime (30d)

# Offline verification without Spotify credentials:
# SPOTIFY_MOCK=1
# LASTFM_MOCK=1
