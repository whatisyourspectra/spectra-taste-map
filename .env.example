# Last.fm API key — the taste-map data source (tag/genre enrichment).
# Get one free (registration only, no approval needed) at:
#   https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Origin of the Vite dev client (used for CORS).
CLIENT_APP_ORIGIN=http://127.0.0.1:5173

# Set to 'production' to enable secure cookies / caching in prod.
# NODE_ENV=development

# Optional tuning (defaults shown):
# ENRICH_MAX_TRACKS=1500        # cap tracks processed per import
# HANDOFF_TTL_MS=21600000       # mobile-companion handoff lifetime (6h)
# LASTFM_CONCURRENCY=5          # parallel Last.fm requests
# LASTFM_CACHE_TTL_MS=86400000  # per-track tag cache lifetime (24h)
